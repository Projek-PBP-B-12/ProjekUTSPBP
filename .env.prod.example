DB_NAME=<nama database>
DB_HOST=<host database>
DB_PORT=<port database>
DB_USER=<username database>
DB_PASSWORD=<password database>
SCHEMA=tutorial
PRODUCTION=True
DEBUG=False
# Wajib: isi kunci acak baru di panel environment PWS. Jangan commit nilainya.
SECRET_KEY=
ALLOWED_HOSTS=justin-evan-titiklapar.pws.cs.ui.ac.id
CSRF_TRUSTED_ORIGINS=https://justin-evan-titiklapar.pws.cs.ui.ac.id

# Ganti URL dengan domain deployment. Console adalah default aman saat setup.
SITE_URL=https://justin-evan-titiklapar.pws.cs.ui.ac.id
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TitikLapar <noreply@example.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30

# Setelah kredensial layanan email diisi melalui environment deployment,
# ubah EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend.
