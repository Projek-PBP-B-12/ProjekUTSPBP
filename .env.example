PRODUCTION=False
DEBUG=True
# Opsional di lokal; jika kosong, aplikasi memakai kunci khusus pengembangan.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Lokal: isi email ditampilkan di terminal, tidak dikirim ke penerima.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SITE_URL=http://127.0.0.1:8000
DEFAULT_FROM_EMAIL=TitikLapar <noreply@example.com>

# Isi hanya ketika layanan SMTP sudah siap, lalu ganti EMAIL_BACKEND menjadi
# django.core.mail.backends.smtp.EmailBackend. Jangan commit kredensial asli.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=30
